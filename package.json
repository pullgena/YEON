{
  "name": "yeon-chat",
  "productName": "YEON",
  "version": "0.7.1",
  "private": true,
  "description": "YEON independent client-server messaging app",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dev": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "server": "node server.js",
    "dist:server": "electron-builder --config server-builder.config.js --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yeon.chat",
    "productName": "YEON",
    "asar": true,
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "index.html",
      "package.json",
      "veylo/index.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YEON"
    }
  }
}
