{
  "name": "yeon-chat",
  "productName": "YEON",
  "version": "0.2.0",
  "private": true,
  "description": "YEON desktop community chat",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dev": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yeon.chat",
    "productName": "YEON",
    "asar": true,
    "files": [
      "electron-main.js",
      "server.js",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YEON-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YEON"
    }
  }
}
