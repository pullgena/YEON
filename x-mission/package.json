{
  "name": "yeon-x-mission",
  "version": "1.0.0",
  "description": "YEON X button mission",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yeon.xmission",
    "productName": "YEON X Mission",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YEON-X-Mission-${version}-${arch}.${ext}"
    }
  }
}